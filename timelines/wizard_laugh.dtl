join phone right [extra_data="set Screen/IncomingCall, set Person/Wizard"]
RING RING
- Pick up the phone
	join protag left 
	update phone [extra_data="set Screen/CallPresent"]
	[signal arg_type="dict" arg="{"Camera":"WizardCamera","Priority":15}"]
	wizard: Ahahahahahah!
	wizard: Well now!
	wizard: This is a real treat!
	wizard: This curse is going to make quick work of you, Green-Haired Fool!
